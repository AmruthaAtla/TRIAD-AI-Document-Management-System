# =================================================================
# TRIAD AI DMS - Environment Variables Template
# Copy this file to '.env' and populate with your configuration.
# DO NOT commit the actual '.env' file to version control.
# =================================================================

# Flask Application Secret Key (e.g. generated via secrets.token_hex(32))
SECRET_KEY=replace-with-a-secure-random-secret-key

# JWT Authentication Secret Key (e.g. generated via secrets.token_hex(32))
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key

# MongoDB Connection URI (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name (defaults to triad_dms if not specified)
DATABASE_NAME=triad_dms
